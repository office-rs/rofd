{
  "name": "@office-rs/rofd",
  "version": "0.1.6",
  "description": "TypeScript SDK wrapping the rofd WASM OFD exports.",
  "license": "Apache-2.0",
  "author": "ravenq",
  "homepage": "https://github.com/office-rs/rofd#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/office-rs/rofd.git",
    "directory": "crates/web-view/sdk"
  },
  "bugs": {
    "url": "https://github.com/office-rs/rofd/issues"
  },
  "keywords": [
    "ofd",
    "ofd-editor",
    "gbt-33190",
    "wasm",
    "webgpu",
    "annotation",
    "rust"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir sdk/dist ../",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:wasm && npm run build:ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "typescript": "^5.4.0"
  }
}