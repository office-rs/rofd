{
  "name": "@rofd/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK wrapping the rofd WASM editor exports.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "src/index.ts",
      "import": "src/index.ts"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir sdk/dist ../",
    "build": "npm run build:wasm"
  },
  "files": [
    "dist",
    "src"
  ]
}
